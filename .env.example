# Copie para .env.local e preencha. .env.local não vai para o git.

# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (sb_publishable_...). Vai para o navegador; o RLS é o que protege.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Só no servidor — atravessa o RLS, nunca expor no cliente.
SUPABASE_SECRET_KEY=

# OCR do statement (console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcional. Padrão claude-opus-5; claude-haiku-4-5 custa 5x menos.
# Rode `npm run eval:ocr` antes de trocar.
OCR_MODEL=
